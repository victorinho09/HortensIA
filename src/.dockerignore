# Build context for the detection server Docker image.
# Keep the image small: only the Python backend, config.json and the YOLO model
# are needed. Everything below is excluded from the build context.

# Frontend / mobile (not part of the dockerized server)
frontend/

# Python virtual environments
backend/.venv/
backend/.tfg/
**/.venv/
**/.tfg/

# Python caches and artifacts
**/__pycache__/
**/*.pyc
**/*.pyo
**/.pytest_cache/
**/.mypy_cache/
**/.ruff_cache/

# Sample images are mounted at runtime via docker-compose, not baked in
backend/demo/samples/*
!backend/demo/samples/.gitkeep
!backend/demo/samples/README.md

# Docs and design files
DOCS/

# VCS / editor
.git/
.gitignore
.vscode/
.DS_Store

# Shell scripts for the native (non-docker) workflow
scripts/
commands.txt
